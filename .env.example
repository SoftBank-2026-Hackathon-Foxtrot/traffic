# 실제 값은 Foxtrot/.env(레포 바깥)에 둔다. 이 파일에는 키 이름만 적는다.
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_API_TOKEN_AUTOMATION=
CF_API_TOKEN=
CF_TUNNEL_TOKEN_EXP_A=
CF_TUNNEL_TOKEN_EXP_B=

# 트래픽 제어 API: 환경 이름과 Cloudflare pool ID 매핑
CF_LB_ID=
CF_POOL_IDS={"aws":"AWS_POOL_ID","gcp":"GCP_POOL_ID"}
# 선택값. 저장소 루트에서 실행할 때의 기본 경로
TRAFFIC_DB_PATH=server/traffic.db
# 플랫폼 v1 호출 전용 Bearer 토큰 (Cloudflare 토큰과 별도)
TRAFFIC_SERVICE_TOKEN=
